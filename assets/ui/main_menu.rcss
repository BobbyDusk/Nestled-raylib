body {
    font-family: Mansalva;
    font-size: 25dp;
    color: #212121;
    width: 100%;
    height: 100%;
    cursor: default;
}

#menu {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 400dp;
    padding: 3em;
    background: #ffffffcc;
    border: 2dp #999;
}

h1 {
    font-size: 2em;
    font-weight: bold;
    margin-bottom: 0.8em;
    text-align: center;
}

button {
    display: block;
    border: 0;
}

button:hover {
    cursor: pointer;
    transform: scale(1.05);
}

button:active {
    transform: scale(1.05);
}

.text-button {
    width: 240dp;
    height: 60dp;
    line-height: 60dp;
    text-align: center;
    font-size: 1em;
    font-weight: 600;
    flex-shrink: 0;
}

.square-button {
    width: 196dp;
    height: 196dp;
    display: flex;
    align-items: center;
    justify-content: center;
}

.square-button * {
    width: 83%;
    height: 83%;
}

.squares-columns {
    display: flex;
    gap: 20dp;
    margin-top: 2em;
}

.squares-column {
    display: flex;
    flex-direction: column;
    gap: 20dp;
}